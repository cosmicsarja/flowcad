(export (version "E") (design (source "flowcad") (date "2024")) (components
  (comp (ref "J11") (value "AC Input Screw Terminal") (footprint "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MPT-0,5-3-2.54_1x03_P2.54mm_Horizontal") (description "3-pin screw terminal (L, N, GND) for mains AC power input"))
  (comp (ref "F11") (value "Fuse 2A 250V") (footprint "Fuse:Fuse_1206_3216Metric") (description "2A 250VAC SMD fuse, mains protection for AC power supply"))
  (comp (ref "L11") (value "Ferrite Bead 600Ω") (footprint "Inductor_SMD:L_0603_1608Metric") (description "Ferrite bead 600Ω@100MHz, EMI filter for power rails"))
  (comp (ref "BR11") (value "Bridge Rectifier KBP206") (footprint "Diode_THT:D_Bridge_Round_D10.1mm") (description "2A 600V THT bridge rectifier module, AC mains to DC full-wave"))
  (comp (ref "U11") (value "LNK626PG") (footprint "Package_DIP:PowerIntegrations_PDIP-8C") (description ""))
  (comp (ref "C11") (value "Ceramic Cap 100nF") (footprint "Capacitor_SMD:C_0603_1608Metric") (description "X7R 100nF ceramic decoupling capacitor, 50V"))
  (comp (ref "T11") (value "Transformer Header 2×2P") (footprint "Connector_PinHeader_2.54mm:PinHeader_2x02_P2.54mm_Vertical") (description "4-pin THT header for off-board mains transformer (primary / secondary windings)"))
  (comp (ref "D11") (value "Schottky Diode SS14") (footprint "Diode_SMD:D_SMA") (description "1A 40V Schottky diode, reverse polarity protection & flyback"))
  (comp (ref "C21") (value "Electrolytic 1000µF 50V") (footprint "Capacitor_THT:CP_Radial_D10.0mm_P5.00mm") (description "1000µF 50V electrolytic bulk filter capacitor, for DC smoothing after rectifier"))
  (comp (ref "U21") (value "Optocoupler 4N35") (footprint "Package_DIP:DIP-6_W7.62mm") (description "Phototransistor optocoupler, isolates primary/secondary in SMPS feedback"))
  (comp (ref "D21") (value "LED Green 0805") (footprint "LED_SMD:LED_0805_2012Metric") (description "Green indicator LED, 0805, 20mA, 525nm"))
  (comp (ref "R11") (value "Resistor 330Ω") (footprint "Resistor_SMD:R_0603_1608Metric") (description "Thick film resistor 330Ω ±1%, LED current limiting"))
  (comp (ref "J21") (value "DC Output Terminal 2P") (footprint "TerminalBlock_Phoenix:TerminalBlock_Phoenix_MPT-0,5-2-2.54_1x02_P2.54mm_Horizontal") (description "2-pin screw terminal for DC output (+V, GND) of power supply"))
) (nets
  (net (code "54") (name "AC_MAINS")
    (node (ref "J11") (pin "1"))
    (node (ref "F11") (pin "1"))
  )
  (net (code "460") (name "AC_PROT")
    (node (ref "F11") (pin "2"))
    (node (ref "L11") (pin "1"))
  )
  (net (code "176") (name "AC_FILT")
    (node (ref "L11") (pin "2"))
    (node (ref "BR11") (pin "1"))
  )
  (net (code "929") (name "HV_DC")
    (node (ref "BR11") (pin "2"))
    (node (ref "U11") (pin "1"))
    (node (ref "BR11") (pin "3"))
    (node (ref "T11") (pin "1"))
  )
  (net (code "636") (name "DRAIN")
    (node (ref "U11") (pin "2"))
    (node (ref "T11") (pin "2"))
  )
  (net (code "938") (name "SEC_AC")
    (node (ref "T11") (pin "3"))
    (node (ref "D11") (pin "1"))
  )
  (net (code "878") (name "+12V")
    (node (ref "D11") (pin "2"))
    (node (ref "U21") (pin "1"))
    (node (ref "D11") (pin "3"))
    (node (ref "D21") (pin "1"))
    (node (ref "D11") (pin "4"))
    (node (ref "J21") (pin "1"))
  )
  (net (code "452") (name "FB_OPT")
    (node (ref "U21") (pin "2"))
    (node (ref "U11") (pin "3"))
  )
  (net (code "67") (name "+3V3")
  )
  (net (code "793") (name "GND")
  )
  (net (code "212") (name "+5V")
  )
)
)