# ─── LLM Provider (ONE required) ──────────────────────────────────────────
# Option A: Google Gemini AI Studio (recommended — free tier available)
GEMINI_API_KEY=AIza...
# Optional: override the model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.5-pro

# Option B: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Option C: OpenAI GPT-4o
# OPENAI_API_KEY=sk-...

# Fallback: OpenAI GPT-4o (used if ANTHROPIC_API_KEY is not set)
# OPENAI_API_KEY=sk-...

# ─── Supabase (optional — persistence is non-fatal if missing) ───────────────
SUPABASE_URL=https://behbsukelneeihajalfh.supabase.co
# Service role key (needed to bypass RLS — get from Supabase dashboard > Settings > API)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Anon key (read-only fallback)
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJlaGJzdWtlbG5lZWloYWphbGZoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU3NDc2NzMsImV4cCI6MjEwMTMyMzY3M30.eVvcRjFwbNRZM645BVdQ4BVgAO_Y8eTmyTUi_JWuT5w

# ─── KiCad paths (required for stages 5–8) ──────────────────────────────────
# Mac (Homebrew): brew install --cask kicad
# Then locate with: which kicad-cli
KICAD_CLI_PATH=/Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli

# KiCad Python scripting path (for pcbnew API — stages 5, 6)
# Find with: python3 -c "import pcbnew; print(pcbnew.__file__)"
KICAD_SCRIPTING_PATH=/Applications/KiCad/KiCad.app/Contents/Frameworks/Python.framework/Versions/Current/lib/python3.9/site-packages

# KiCad symbol library path (for SKiDL)
KICAD_SYMBOL_LIBS=/Applications/KiCad/KiCad.app/Contents/SharedSupport/library

# ─── Application ────────────────────────────────────────────────────────────
# Working directory for intermediate files (netlists, PCB files, exports)
WORK_DIR=./tmp

# Path to component library JSON
COMPONENT_LIB_PATH=./component_library/components.json

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
